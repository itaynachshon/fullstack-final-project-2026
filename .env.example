# ─── Supabase — required at runtime (local dev and Vercel) ───────────────────
# Copy this file to .env.local and fill in the values from:
# Supabase Dashboard → Project Settings → API
#
# Both NEXT_PUBLIC_* values are client-safe by design: Row Level Security in
# the database is the authorization boundary, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Local-only — NEVER set on Vercel, NEVER commit a real value ─────────────
# Used exclusively by the local catalog seed script (npm run seed:db) to
# bulk-insert seeded products, and (optionally) by the reminders RLS e2e spec
# to seed one server-created notification the way the Edge Function worker
# does. It bypasses Row Level Security; no runtime application code on
# Vercel reads it. The F2 reminder worker gets its own copy of this key from
# SUPABASE EDGE FUNCTION SECRETS, not from here (docs/RESTOCK_REMINDERS.md).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Restock reminders (F2) — configured in SUPABASE, not in this file ───────
# The reminder worker is a Supabase Edge Function; its secrets (BREVO_API_KEY,
# RESTOCK_EMAIL_FROM, APP_URL, RESTOCK_CRON_SECRET) are set with
# `supabase secrets set` / supabase/functions/.env for local serving — never
# as NEXT_PUBLIC_*, never on Vercel. See supabase/functions/.env.example and
# docs/RESTOCK_REMINDERS.md.

# ─── Recipe AI chat (F3) — SERVER-SIDE ONLY, never NEXT_PUBLIC_ ──────────────
# Free-tier keys: https://aistudio.google.com/apikey · https://console.groq.com/keys
# The app works with either key alone; the failover chain skips providers
# whose key is missing. Normal unit tests/CI never call these vendors —
# real-key verification is the opt-in script: node scripts/ai-smoke.mjs
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Optional overrides (defaults shown). AI_PROVIDER_ORDER is the failover
# order; ids: google, groq. Model ids are configuration, not code.
# AI_PROVIDER_ORDER=google,groq
# AI_GOOGLE_MODEL=gemini-2.5-flash
# AI_GROQ_MODEL=llama-3.3-70b-versatile
# AI_PROVIDER_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=2048

# ─── Optional E2E / RLS tests — dedicated non-production users only ──────────
# The public Playwright checks run without these. Authenticated journeys need
# User A; cross-user RLS verification additionally needs User B. Keep these in
# .env.local or CI secrets, never in a committed file.
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

# Optional deterministic seeded-catalog Search journey. Set both values only
# after the target Supabase project has been seeded. With the committed
# catalog, the known-good pair is query במבה / product name "במבה 80 גרם אסם".
E2E_CATALOG_QUERY=במבה
E2E_CATALOG_PRODUCT_NAME=
# Optional typed-barcode lookup journey (same product): e.g. 7290000066318.
E2E_CATALOG_BARCODE=

# Optional: target an already-running local/preview/production deployment.
# PLAYWRIGHT_BASE_URL=https://example.vercel.app

# ─── Supabase — required at runtime (local dev and Vercel) ───────────────────
# Copy this file to .env.local and fill in the values from:
# Supabase Dashboard → Project Settings → API
#
# Both NEXT_PUBLIC_* values are client-safe by design: Row Level Security in
# the database is the authorization boundary, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Local-only — NEVER set on Vercel, NEVER commit a real value ─────────────
# Used exclusively by the local catalog seed script (npm run seed:db) to
# bulk-insert seeded products. It bypasses Row Level Security; no runtime
# application code reads it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional E2E / RLS tests — dedicated non-production users only ──────────
# The public Playwright checks run without these. Authenticated journeys need
# User A; cross-user RLS verification additionally needs User B. Keep these in
# .env.local or CI secrets, never in a committed file.
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

# Optional deterministic seeded-catalog Search journey. Set both values only
# after the target Supabase project has been seeded. With the committed
# catalog, the known-good pair is query במבה / product name "במבה 80 גרם אסם".
E2E_CATALOG_QUERY=במבה
E2E_CATALOG_PRODUCT_NAME=

# Optional: target an already-running local/preview/production deployment.
# PLAYWRIGHT_BASE_URL=https://example.vercel.app

# ─── Edge Function secrets — restock-reminders ───────────────────────────────
# LOCAL DEV: copy to supabase/functions/.env (gitignored) and pass it to
#   supabase functions serve restock-reminders --env-file supabase/functions/.env
# HOSTED: set the same names with `supabase secrets set NAME=value` — these are
# Supabase Edge Function secrets. They must NEVER be set on Vercel or appear in
# any NEXT_PUBLIC_* variable.
#
# (SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by the
#  platform — locally by `supabase functions serve`, hosted by Supabase.)

# Shared bearer secret gating the worker. The pg_cron job reads the SAME value
# from Supabase Vault (see supabase/functions/restock-reminders/cron.sql).
# Generate one, e.g.:  openssl rand -hex 32
RESTOCK_CRON_SECRET=

# Brevo transactional email (https://app.brevo.com → SMTP & API → API keys).
# Leave empty to run in-app-only: email sends are then reported as disabled.
BREVO_API_KEY=

# Verified Brevo sender address, e.g. reminders@your-domain.example
RESTOCK_EMAIL_FROM=

# Public app origin for the email call-to-action link, no trailing slash,
# e.g. https://your-app.vercel.app
APP_URL=

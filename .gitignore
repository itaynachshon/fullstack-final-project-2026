# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# generated: ZXing WASM decoder binary, copied from node_modules by
# scripts/sync-zxing-wasm.mjs (predev/prebuild/pretest) — never hand-edited
/public/wasm/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values; the example file documents the names
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
ext-env.d.ts


# markdowns
*Assignment.md

# cursor
.cursor*
.cursor/plans/

# AI agent files — auto-generated by next dev; kept local, not tracked
/AGENTS.md
/CLAUDE.md
